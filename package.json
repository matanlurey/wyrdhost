{
  "name": "wyrdhost-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "./scripts/workspaces.sh build",
    "check": "./scripts/check.sh",
    "dev": "npm run dev --workspace @wyrdhost/game --",
    "format": "./scripts/format.sh --write",
    "format:check": "./scripts/format.sh --check",
    "lint": "./scripts/lint.sh",
    "storybook": "npm run storybook --workspace @wyrdhost/game --",
    "storybook:build": "npm run storybook:build --workspace @wyrdhost/game",
    "typecheck": "./scripts/workspaces.sh typecheck",
    "test": "vitest run --passWithNoTests",
    "test:ui": "npm run test:ui --workspace @wyrdhost/game",
    "commitlint": "commitlint --default-config",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.md": "prettier --write",
    "!(*.md)": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "commitlint": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
