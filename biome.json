{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all"
    },
    "domains": {
      "project": "all",
      "react": "all",
      "test": "all",
      "types": "all"
    }
  },
  "overrides": [
    {
      "includes": ["apps/game/src/**/*.ts", "apps/game/src/**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "correctness": {
            "noSolidDestructuredProps": "off",
            "useQwikValidLexicalScope": "off"
          },
          "performance": {
            "useSolidForComponent": "off"
          },
          "suspicious": {
            "noReactSpecificProps": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/game/.storybook/*.ts",
        "apps/game/src/**/*.stories.ts",
        "apps/game/src/**/*.stories.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
